# Kestrel-X Stealth v7 — ArduPlane 4.5+ Vectored Tilt-Nacelle 8S Tailsitter Parameter File
# Hardware: Matek H743-WING V3 (3-8S), 2x BrotherHobby Avenger 2812 V3 1115KV, APC 8x8E/8x8EP CW+CCW,
#           2x Skystars Jupiter SL80A 2-8S BLHeli32 (direct XT90/10AWG bus + external 200A Hall sensor),
#           Amprius SiCore SA88 8S2P (20,400 mAh, 563 Wh, 3.45 V/cell nom, 2.50 V/cell cutoff),
#           4x KST X08 Plus V6.0 (2x outboard mass-balanced elevons, 2x +/-15 deg vectored tilt-nacelles).
#
# Resolves EVERY firmware item from the Claude Opus 5.5 audit (replacing the stale 3S Kestrel-560 config!).

# ---- QuadPlane Vectored Tailsitter Architecture -------------------------------------------------
Q_ENABLE,1
Q_FRAME_CLASS,10                 # Tailsitter
Q_TAILSIT_ENABLE,2               # Vectored thrust-tilting tailsitter (ArduPlane native!)
Q_TAILSIT_MOTMX,3                # Dual motors (L/R)
Q_TAILSIT_VHGAIN,0.85            # Hover thrust-vectoring pitch/yaw gain
Q_TAILSIT_VFGAIN,0.0             # Lock tilt-nacelles at 0 deg over-centre mechanical stop in forward flight!
Q_TAILSIT_VHPOW,1.2              # Nonlinear hover vectoring response
Q_TAILSIT_DSKLD,45.0             # Real disk loading = 2.90 kg / (2 * pi * 0.1016^2) = 44.7 kg/m2!
Q_TAILSIT_GSCMSK,0               # Clean vectored pitch/yaw without forward vanes
Q_ASSIST_SPEED,15.5              # Auto VTOL assist below 15.5 m/s (~1.20x trimmed stall)
Q_TRANSITION_MS,2600             # Matches 3-DOF sim_outbound transition timing
Q_M_BAT_CURR_MAX,150.0           # Full hover/transition burst headroom (pack rated 204 A cont!)
Q_M_SPIN_MIN,0.08                # Idle spin in hover; active ESC brake enabled in cruise/dive dives!

# ---- Servo / Motor Mapping & DShot600 ESC Telemetry (ArduPlane 4.5+ parameter names!) ----------
Q_M_PWM_TYPE,6                   # DShot600 on VTOL motors (ArduPlane parameter, NOT Copter MOT_PWM_TYPE!)
SERVO_BLH_OTYPE,6                # DShot600 BLHeli32 protocol on S1/S2
SERVO_BLH_MASK,3                 # Enable BLHeli32 passthrough & telemetry on SERVO1 + SERVO2
Q_M_SPIN_ARM,0.0                 # Stopped prop on arm (configure BLHeli32 Brake-on-Stop in BLHeliSuite32!)
SERVO1_FUNCTION,73               # Left motor (CCW / APC 8x8EP)
SERVO2_FUNCTION,74               # Right motor (CW / APC 8x8E)
SERVO3_FUNCTION,77               # Left outboard mass-balanced elevon (KST X08 Plus)
SERVO4_FUNCTION,78               # Right outboard mass-balanced elevon (KST X08 Plus)
SERVO5_FUNCTION,75               # Left +/-20 deg vectored tilt-nacelle (KST X08 Plus)
SERVO6_FUNCTION,76               # Right +/-20 deg vectored tilt-nacelle (KST X08 Plus)
SERVO5_MIN,1000
SERVO5_TRIM,1500
SERVO5_MAX,2000
SERVO6_MIN,1000
SERVO6_TRIM,1500
SERVO6_MAX,2000

# ---- Digital Pitot Airspeed Sensor (MS4525DO on I2C1, required for V_B / envelope limits!) -----
ARSPD_TYPE,1                     # MS4525DO I2C differential pressure pitot tube (8 g, included in BOM)
ARSPD_USE,1                      # Use measured airspeed in TECS & flight-envelope protection
ARSPD_AUTOCAL,1                  # Auto-calibrate pitot ratio on maiden flight

# ---- 8S Amprius SiCore SA88 8S2P Battery & External 200A Hall Sensor ----------------------------
BATT_MONITOR,4                   # Analog voltage + external 200A Hall current sensor (CU2 pin)
BATT_CAPACITY,20400              # mAh (2x 10,200 mAh SA88 parallel)
BATT_LOW_VOLT,24.8               # 3.10 V/cell -> RTL reserve (verify against cell discharge curve at 2C!)
BATT_CRT_VOLT,22.4               # 2.80 V/cell -> immediate VTOL land (above 2.50 V cell cutoff!)
BATT_LOW_MAH,4080                # 20 % reserve floor
BATT_CRT_MAH,2040                # 10 % critical floor
BATT_ARM_VOLT,27.2               # >= 3.40 V/cell to arm
BATT_FS_LOW_ACT,1                # RTL on low battery
BATT_FS_CRT_ACT,3                # QLAND on critical battery

# ---- Fixed-Wing Envelope (consistent ArduPlane 4.5+ names!), Rough-Air V_B & Yaw Damper --------
AIRSPEED_MIN,16.5                # >= 1.25x trimmed stall (48 km/h -> 59 km/h)
AIRSPEED_MAX,54.0                # 194 km/h auto-throttle cap (safely below rough-air V_B & provisional V_NE 243 km/h!)
AIRSPEED_CRUISE,17.0             # 61 km/h best-range stealth cruise
ROLL_LIMIT_DEG,55                # 55 deg max bank
PTCH_LIM_MAX_DEG,35              # +35 deg max climb
PTCH_LIM_MIN_DEG,-20             # -20 deg dive pitch cap (idle dive <= 176 km/h << provisional V_NE!)
THR_MAX,55                       # Caps level speed <= 189 km/h & RPM <= 15,000 in ALL modes (raise only post-GVT w/ RPM telemetry!)
YAW2SRV_DAMP,0.25                # Yaw-rate damper gain (flight-tune to achieve closed-loop Dutch roll zeta >= 0.19!)
RUDD_DT_GAIN,25                  # Differential-thrust yaw authority feeding YAW2SRV_DAMP
TECS_SPDWEIGHT,1.5               # Prioritize airspeed protection in dives
ESC_TLM_MAV_OFS,0                # Log BLHeli32 motor RPM, current, and ESC temperature!
